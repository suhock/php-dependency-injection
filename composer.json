{
    "name": "suhock/dependency-injection",
    "description": "PHP Dependency Injection Library",
    "type": "library",
    "keywords": [
        "dependency injection",
        "dependency",
        "injection",
        "di",
        "inversion of control",
        "ioc"
    ],
    "homepage": "https://github.com/suhock/php-dependency-injection",
    "readme": "README.md",
    "license": "MIT",
    "authors": [
        {
            "name": "Matthew Suhocki",
            "email": "matt@suhock.net"
        }
    ],
    "require": {
        "php": "^8.4",
        "suhock/disposable": "^1.0"
    },
    "require-dev": {
        "ergebnis/phpstan-rules": "^2.13",
        "friendsofphp/php-cs-fixer": "^v3.95",
        "phpstan/phpstan": "^2.2",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^13.2",
        "suhock/php-cs-fixer-rules": "^1.0.0",
        "suhock/phpstan-rules": "^1.0.0"
    },
    "suggest": {
        "ext-apcu": "To cache resolved dependencies with ApcuCache"
    },
    "autoload": {
        "psr-4": {
            "Suhock\\DependencyInjection\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Suhock\\DependencyInjection\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "scripts": {
        "php-cs-fixer": "php-cs-fixer fix .",
        "phpstan": "phpstan analyse -c phpstan.neon.dist",
        "test": "phpunit -c ."
    }
}
