includes:
    - phar://vendor/phpstan/phpstan/phpstan.phar/conf/bleedingEdge.neon
    - vendor/phpstan/phpstan-strict-rules/rules.neon

parameters:
    level: 10
    paths:
        - src
        - tests
    checkImplicitMixed: true
    checkBenevolentUnionTypes: true
    checkUninitializedProperties: true
    checkMissingCallableSignature: false
    reportAnyTypeWideningInVarTag: true
    reportPossiblyNonexistentGeneralArrayOffset: true
    reportPossiblyNonexistentConstantArrayOffset: true
    reportWrongPhpDocTypeInVarTag: true

services:
    -
        class: Suhock\DependencyInjection\PHPStan\InjectMethodAlwaysUsedExtension
        tags:
            - phpstan.methods.alwaysUsedMethodExtension
    -
        class: Suhock\DependencyInjection\PHPStan\KeyWithoutInjectPropertyRule
        tags:
            - phpstan.rules.rule
